DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_DATABASE=holicindo_web
DB_SSL=false

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

PORT=3011
NODE_ENV=development

FRONTEND_URL=http://localhost:3010

# AWS S3 Storage Config (Rekomendasi untuk Produksi & Amplify)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=nama-bucket-s3-anda
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_S3_CUSTOM_DOMAIN= https://my-bucket.s3.ap-southeast-1.amazonaws.com # Opsional

# Local storage fallback jika AWS_S3_BUCKET tidak di-set
UPLOAD_DIR=

# Gemini AI untuk fitur Generate SEO (opsional)
GEMINI_API_KEY=your_gemini_api_key_here
