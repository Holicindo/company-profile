DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_DATABASE=holicindo_web
DB_SSL=false

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

PORT=3011
NODE_ENV=development

FRONTEND_URL=http://localhost:3010

# Absolut path untuk penyimpanan file upload
# Di production: set ke path di luar folder app, misal /var/www/holicindo/uploads
# Di Docker: mount volume ke path ini
UPLOAD_DIR=

# Gemini AI untuk fitur Generate SEO (opsional)
GEMINI_API_KEY=your_gemini_api_key_here
